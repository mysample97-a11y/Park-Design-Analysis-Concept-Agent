# Dependencies — never commit. ~200MB, and reinstallable from package-lock.json.
node_modules/

# Build output — regenerated by `npm run build` on every deploy.
# Committing it also DUPLICATES public/videos (21MB) into the repo a second time.
dist/
dist-ssr/
*.local

# Test scaffolding generated by the harnesses
harness_out/
harness_entry.js

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets — must never reach a public repo
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
